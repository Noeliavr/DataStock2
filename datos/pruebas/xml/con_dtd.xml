<?xml version="1.0" encoding="UTF-8"?>
<!-- CP-XML-03. Ataque XXE (XML External Entity). El DOCTYPE define una entidad llamada secreto que intenta leer un fichero del ordenador (/etc/passwd) y meterlo en el nombre. Resultado esperado: se rechaza el documento entero, porque el programa prohíbe los DOCTYPE con disallow-doctype-decl. -->
<!DOCTYPE catalogo [
  <!ENTITY secreto SYSTEM "file:///etc/passwd">
]>
<catalogo>
  <producto>
    <codigo>XXE-001</codigo><nombre>&secreto;</nombre>
    <precio>1.00</precio><stock>1</stock>
    <categoriaId>1</categoriaId><proveedorId>1</proveedorId>
  </producto>
</catalogo>
